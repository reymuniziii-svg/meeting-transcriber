{
  "manifest_version": 3,
  "name": "Meeting Transcriber",
  "version": "1.1.0",
  "description": "Capture live meeting audio, transcribe with Whisper, and merge real speaker names from meeting UIs.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "downloads",
    "activeTab",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://teams.cloud.microsoft/*",
    "https://teams.live.com/*",
    "https://app.zoom.us/*",
    "https://zoom.us/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' ws://127.0.0.1:9090 ws://localhost:9090;"
  },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["lib/speaker-tracker.js", "lib/storage.js", "lib/selector-validator.js", "content-scripts/google-meet.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*",
        "https://teams.live.com/*"
      ],
      "js": ["lib/speaker-tracker.js", "lib/storage.js", "lib/selector-validator.js", "content-scripts/ms-teams.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.zoom.us/*",
        "https://zoom.us/*"
      ],
      "js": ["lib/speaker-tracker.js", "lib/storage.js", "lib/selector-validator.js", "content-scripts/zoom-web.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meeting Transcriber"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
